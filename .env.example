# Required for the language model. Choose a model with function/tool calling.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.6
# Optional: use a cheaper/faster tool-capable model for the research loop.
# OPENROUTER_RESEARCH_MODEL=anthropic/claude-sonnet-4.6

# Required for the agent's only tool: web search.
EXA_API_KEY=

# Optional for text chat; required for microphone and spoken answers.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5

# Optional. Use persistent local storage, not an ephemeral serverless filesystem.
DATABASE_PATH=./data/minimi.sqlite
